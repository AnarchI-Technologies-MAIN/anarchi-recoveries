{
  "name": "anarchi-recoveries",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test:authz": "npm --workspace @anarchi/authz test",
    "typecheck:authz": "npm --workspace @anarchi/authz run typecheck",
    "test:design-tokens": "npm --workspace @anarchi/design-tokens test",
    "typecheck:design-tokens": "npm --workspace @anarchi/design-tokens run typecheck",
    "test:ui": "npm --workspace @anarchi/ui test",
    "typecheck:ui": "npm --workspace @anarchi/ui run typecheck",
    "test:observability": "npm --workspace @anarchi/observability test",
    "typecheck:observability": "npm --workspace @anarchi/observability run typecheck"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
