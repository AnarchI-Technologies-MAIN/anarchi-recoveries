{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.anarchi.tech/recoveries/secret-capability.v1.schema.json",
  "title": "AnarchI Recoveries opaque secret capability v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["lease_id", "secret_ref", "organization_id", "purpose", "operation", "expires_at"],
  "properties": {
    "lease_id": { "type": "string", "minLength": 1 },
    "secret_ref": { "type": "string", "minLength": 1 },
    "organization_id": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
